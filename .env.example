# YouTube Learning & Notes Agent Environment Configuration

# Required: Google Gemini API Key for note generation and multimodal processing
# Get your API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to save exported Markdown (.md) note sheets (Default: ~/Documents/learning_notes)
# This folder can be opened directly as an Obsidian Vault or Notion directory.
NOTES_EXPORT_DIR=/Users/akankshbandaru/Documents/learning_notes

# Optional: Server Configuration
HOST=0.0.0.0
PORT=8000
